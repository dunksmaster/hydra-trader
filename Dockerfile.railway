# Railway All-in-One: build backend from this source (so Telegram listener starts),
# reuse official frontend image and TA-Lib libraries.

FROM ghcr.io/nofxaios/nofx/nofx-backend:latest AS backend-libs

FROM golang:1.25.11-alpine AS backend-builder

RUN apk add --no-cache git make gcc g++ musl-dev

COPY --from=backend-libs /usr/local /usr/local

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux \
    CGO_CFLAGS="-D_LARGEFILE64_SOURCE" \
    go build -trimpath -ldflags="-s -w" -o nofx .

FROM ghcr.io/nofxaios/nofx/nofx-frontend:latest AS frontend

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata sqlite nginx openssl gettext

COPY --from=backend-builder /app/nofx /app/nofx
COPY --from=backend-libs /usr/local/lib/libta_lib* /usr/local/lib/
RUN ldconfig /usr/local/lib 2>/dev/null || true

COPY --from=frontend /usr/share/nginx/html /usr/share/nginx/html

WORKDIR /app
RUN mkdir -p /app/data

COPY railway/start.sh /app/start.sh
RUN sed -i 's/\r$//' /app/start.sh && chmod +x /app/start.sh

ENV DB_PATH=/app/data/data.db

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-8080}/health || exit 1

CMD ["/app/start.sh"]
